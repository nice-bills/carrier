{
  "expo": {
    "name": "Carrier",
    "slug": "carrier",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "xyz.carrier.mesh",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "xyz.carrier.mesh",
      "permissions": [
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NEARBY_WIFI_DEVICES",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "./plugins/with-multipeer-udp",
      [
        "expo-nearby-connections",
        {
          "bonjourServicesName": "carrier",
          "localNetworkUsagePermissionText": "Carrier uses your local network to find iPhones within about 10 metres and hand payments to them. Nothing goes on the internet.",
          "bluetoothUsagePermissionText": "Carrier uses Bluetooth so iPhones nearby can find each other and pass payments, even with no Wi-Fi around."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Carrier uses your location, rounded to about 100 m, to show where payments passed hand to hand. Only if you turn the map on.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Carrier uses the camera to scan payment codes from a phone next to you. Nothing is recorded or sent anywhere.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
