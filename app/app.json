{
  "expo": {
    "name": "Carrier",
    "slug": "carrier",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "xyz.carrier.mesh",
      "permissions": [
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NEARBY_WIFI_DEVICES",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-nearby-connections",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Carrier uses your location, rounded to about 100 m, to show where payments passed hand to hand. Only if you turn the map on."
        }
      ]
    ]
  }
}
