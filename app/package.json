{
  "name": "@carrier/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "contrast": "node --experimental-strip-types scripts/contrast.ts",
    "preview": "vite --config preview/vite.config.mts"
  },
  "dependencies": {
    "@carrier/client": "*",
    "@carrier/mesh": "*",
    "@carrier/protocol": "*",
    "@maplibre/maplibre-react-native": "~10.4.2",
    "@solana/web3.js": "^1.98.0",
    "buffer": "^6.0.3",
    "expo": "~52.0.0",
    "expo-camera": "~16.0.18",
    "expo-crypto": "~14.0.0",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.0",
    "expo-location": "~18.0.0",
    "expo-nearby-connections": "^1.1.1",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "pako": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-svg": "15.8.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.3.12",
    "@vitejs/plugin-react": "^4.7.0",
    "maplibre-gl": "^5.24.0",
    "playwright-core": "^1.63.0",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.19.13",
    "typescript": "~5.6.0",
    "vite": "^5.4.21"
  }
}
